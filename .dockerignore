# Keep the build context minimal and avoid leaking VCS/secrets into the image
.git
.github
.gitignore
.dockerignore
.devcontainer
README.md
LICENSE
Makefile
docker-compose.yml
build-and-push.yml
dind/

# Secrets / credentials (defense in depth — also in .gitignore)
.github_token
*.key
*.pem
*.token
.env

# Local IaC state
.terraform/
*.tfstate
*.tfstate.*
